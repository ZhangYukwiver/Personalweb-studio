{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "主页工坊",
  "version": "0.1.0",
  "identifier": "com.homepageforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "主页工坊",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "离线生成个人主页",
    "longDescription": "一个本机运行的个人主页生成器，可导出独立 HTML 文件。"
  }
}
